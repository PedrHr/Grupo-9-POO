create database systemBank;

use systemBank;

create table Cliente (
idCliente int primary key auto_increment,
nome varchar(100) not null,
cpf varchar(11) unique,
endereco varchar(150),
email varchar(45) unique not null,
senha varchar(45) not null
);

create table Conta (
numeroConta int primary key auto_increment,
saldoAtual decimal (10,2),
tipo ENUM('CORRENTE, POUPANCA'),
idcliente_cliente int unique,
foreign key (idcliente_cliente) references Cliente(idCliente)
);

create table contaCorrente(
idContaCorrente int primary key,
limiteCredito decimal(10,2),
chaveTransacao bigint unique,
foreign key (idContaCorrente) references Conta(numeroConta)
);

create table contaPoupanca(
idContaPoupanca int primary key,
taxaRendimento decimal not null,
foreign key (idContaPoupanca) references Conta(numeroConta)
);

create table Transacao(
idTransacao int primary key,
valor decimal (10,2) not null,
contaOrigem int,
contaDestino int,
dataTransacao DATETIME not null default current_timestamp(3),
foreign key (contaOrigem) references contaCorrente(idContaCorrente),
foreign key (contaDestino) references contaCorrente(idContaCorrente)
);


ALTER TABLE Transacao
MODIFY idTransacao INT AUTO_INCREMENT;
